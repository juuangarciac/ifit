{"nodes": [{"id": "CLAUDE_md_ifit_project_context", "label": "IFit MAUI Project Context (CLAUDE.md)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "CLAUDE_md_shell_navigation_rules", "label": "Shell Navigation Rules (ShellContent vs RegisterRoute)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 43-75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ShellContent pages are cached (single instance per session) and registered in AppShell.xaml; RegisterRoute pages create a new instance on each push and read fresh Preferences. The rule: if a ViewModel reads Preferences in its constructor, the page MUST be RegisterRoute."}, {"id": "CLAUDE_md_shellcontent_pages", "label": "ShellContent Page List", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "line 49-53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "CLAUDE_md_registerroute_pages", "label": "RegisterRoute Page List", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "line 59-65", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "CLAUDE_md_nav_prefixes", "label": "Navigation Prefix Rules (///, //, relative, ..)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 67-75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/// resets the whole stack to a ShellContent; // navigates to ShellContent without full reset; plain name pushes a RegisterRoute; .. pops. Never use // or /// with a RegisterRoute name."}, {"id": "CLAUDE_md_registration_flow", "label": "New User Registration Auth Flow", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "line 81-101", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "CLAUDE_md_preferences_keys", "label": "Preferences Keys Contract", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "line 109-122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "CLAUDE_md_sqlite_local_cache", "label": "SQLite Local Cache Pattern", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 127-133", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQLite (DatabaseService) is only a cache \u2014 if it fails, the flow continues because the user is already authenticated on the server."}, {"id": "CLAUDE_md_viewmodel_pattern", "label": "ViewModel DI Constructor Pattern", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 136-148", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two constructors: DI constructor for tests/explicit injection, and parameterless constructor for XAML/Shell that delegates to DI via App.GetService<T>(). fire-and-forget InitializeAsync only for RegisterRoute or lightweight init."}, {"id": "CLAUDE_md_tokenmanager_keys", "label": "TokenManager SecureStorage Keys", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "line 152-156", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "CLAUDE_md_visual_style", "label": "Visual Style Spec (Dark Theme, BackgroundPrimaryDark)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 160-164", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permanent dark theme. Main background color #222831 (BackgroundPrimaryDark). Defined in Colors.xaml and Styles.xaml. Android styles.xml overrides Maui.MainTheme to avoid white flash."}, {"id": "CLAUDE_md_bug_white_flash", "label": "Fixed Bug: White Flash on Android Navigation", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 170-172", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cause: default background was white during fragment transitions. Fix: styles.xml Android + Styles.xaml with BackgroundPrimaryDark."}, {"id": "CLAUDE_md_bug_userid_race_condition", "label": "Fixed Bug: UserId Race Condition on Second Registration", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 174-177", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cause: VerificationViewModel.VerifyEmailAsync fired InsertUserToDatabase fire-and-forget before navigation. Preferences.UserId not updated when next screen read it. Fix: synchronous Preferences.Set('UserId') + await InsertUserToDatabase."}, {"id": "CLAUDE_md_bug_questionnaire_inherit", "label": "Fixed Bug: Second Registration Inherits First Questionnaire", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 178-181", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cause: AppUserQuestionnaireView was ShellContent \u2014 VM cached with _responseId, _currentQuestionIndex, _userId of previous user. Fix: moved to RegisterRoute."}, {"id": "CLAUDE_md_bug_preferences_mismatch", "label": "Fixed Bug: Preferences Key Mismatch Name vs UserName", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 182-184", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cause: SignInViewModel saved with key 'Name', GetStartedViewModel read 'UserName'. Fix: unified to 'UserName' everywhere."}, {"id": "CLAUDE_md_bug_registration_complete", "label": "Fixed Bug: RegistrationComplete Never Marked", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 188-191", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cause: AppUserService.MarkRegistrationComplete existed but was never called. Fix: call added in RoutineSummaryViewModel.SaveRoutineAsync after saving the routine."}], "edges": [{"source": "CLAUDE_md_ifit_project_context", "target": "CLAUDE_md_shell_navigation_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 43", "weight": 1.0}, {"source": "CLAUDE_md_shell_navigation_rules", "target": "CLAUDE_md_shellcontent_pages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 45-53", "weight": 1.0}, {"source": "CLAUDE_md_shell_navigation_rules", "target": "CLAUDE_md_registerroute_pages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 55-65", "weight": 1.0}, {"source": "CLAUDE_md_shell_navigation_rules", "target": "CLAUDE_md_nav_prefixes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 67", "weight": 1.0}, {"source": "CLAUDE_md_ifit_project_context", "target": "CLAUDE_md_registration_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 79", "weight": 1.0}, {"source": "CLAUDE_md_ifit_project_context", "target": "CLAUDE_md_preferences_keys", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 109", "weight": 1.0}, {"source": "CLAUDE_md_ifit_project_context", "target": "CLAUDE_md_sqlite_local_cache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 127", "weight": 1.0}, {"source": "CLAUDE_md_ifit_project_context", "target": "CLAUDE_md_tokenmanager_keys", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou