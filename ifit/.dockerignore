# ============================================================================
# .DOCKERIGNORE - ARCHIVOS A EXCLUIR DEL BUILD
# ============================================================================
# 
# Este archivo evita copiar archivos innecesarios a la imagen Docker,
# reduciendo el tamaño y mejorando la velocidad de build.
#
# Coloca este archivo en la raíz de CADA microservicio
# ============================================================================

# Directorios de build
target/
build/
out/
bin/

# IDEs
.idea/
.vscode/
.eclipse/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# Git
.git/
.gitignore
.gitattributes

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Logs
logs/
*.log

# Sistema operativo
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Temporales
tmp/
temp/
*.tmp
*.bak

# Tests y coverage
coverage/
.coverage
htmlcov/

# Node (si tienes frontend)
node_modules/
npm-debug.log
yarn-error.log

# Maven
.mvn/
mvnw
mvnw.cmd

# Gradle  
.gradle/
gradle/
gradlew
gradlew.bat

# Archivos de documentación (opcional)
README.md
LICENSE
CHANGELOG.md
docs/

# Configuraciones locales
.env
.env.local
application-local.properties
application-local.yml
